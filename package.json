{
  "name": "@useauthio/react",
  "version": "0.2.5",
  "description": "React SDK for Authio: hooks, gates, and sign-in helpers for pure SPAs.",
  "author": "Authio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Authio-com/authio_react.git"
  },
  "homepage": "https://authio.com",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "node -e \"console.log(require('fs').statSync('dist/index.js').size + ' bytes (raw)')\""
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^11.0.0",
    "@useauthio/node": "^0.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "vite": "^6.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "form-data": ">=4.0.6",
      "postcss": ">=8.5.18",
      "ws": ">=8.21.0",
      "nanoid": "^3.3.18"
    }
  }
}
